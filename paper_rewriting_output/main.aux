\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Common-cap comparison on LunarLander-v3. Both methods permit at most ten evaluations per run, each using 1M PPO steps. Independent Generation executes 50 trainings; CREATE executes 33 because of early stopping. Held-out: 100 episodes, seeds 50000--50099, never returned to the LLM. Values are mean $\pm $ std over five runs. }}{7}{table.2}\protected@file@percent }
\newlabel{tab:budget}{{2}{7}{Common-cap comparison on LunarLander-v3. Both methods permit at most ten evaluations per run, each using 1M PPO steps. Independent Generation executes 50 trainings; CREATE executes 33 because of early stopping. Held-out: 100 episodes, seeds 50000--50099, never returned to the LLM. Values are mean $\pm $ std over five runs}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces LunarLander-v3 search under a common cap of ten reward evaluations per run. Curves carry forward the best-so-far score after a run terminates. Shaded regions: 95\% bootstrap CI (Independent) and $\pm 1.96\,\text  {SE}$ (CREATE).}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:budget}{{2}{7}{LunarLander-v3 search under a common cap of ten reward evaluations per run. Curves carry forward the best-so-far score after a run terminates. Shaded regions: 95\% bootstrap CI (Independent) and $\pm 1.96\,\text {SE}$ (CREATE)}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Ablation results on LunarLander-v3. Five search runs per condition. LLM-once = initial generation without iteration. Coarse Feedback = structured evidence replaced with scalar summary. Unconstrained = intervention tiers and single-component constraint removed. Held-out: 100 episodes, seeds 50000--50099. }}{7}{table.3}\protected@file@percent }
\newlabel{tab:ablation}{{3}{7}{Ablation results on LunarLander-v3. Five search runs per condition. LLM-once = initial generation without iteration. Coarse Feedback = structured evidence replaced with scalar summary. Unconstrained = intervention tiers and single-component constraint removed. Held-out: 100 episodes, seeds 50000--50099}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-run development scores for the main ablations on LunarLander-v3. Horizontal bars denote means; dashed line marks the 200-point threshold.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:ablation}{{3}{7}{Per-run development scores for the main ablations on LunarLander-v3. Horizontal bars denote means; dashed line marks the 200-point threshold}{figure.3}{}}
